<?xml version="1.0" encoding="utf-8"?>
<!--
    NOTIFICATION FIX — AndroidManifest.xml required declarations

    Cross-check your AndroidManifest.xml against each item below.
    A missing entry here is the most common reason Media3 notifications
    silently fail or crash.
-->
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ──────────────────────────────────────────────────────── -->

    <!--
        REQUIRED on API 33+ (Android 13) for any notification to appear.
        MainActivity already requests this at runtime — it must also be in the manifest.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required to keep MusicService alive as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>

    <!--
        REQUIRED for foregroundServiceType="mediaPlayback".
        Without this the service's startForeground() call is rejected on API 34+
        and the notification is never posted.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Keep CPU awake for background playback -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Media library browsing (for Android Auto and MediaBrowserServiceCompat) -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".DreamerApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dreamer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            MusicService declaration.

            CRITICAL fields:
            - android:exported="true"               ← REQUIRED for MediaBrowserServiceCompat
                                                       and for Media3 notification tap intent;
                                                       without it, PendingIntent.getActivity()
                                                       in buildTapIntent() may be rejected
            - android:foregroundServiceType         ← REQUIRED; must match the permission above
            - The <intent-filter> for SERVICE_INTERFACE ← lets MediaBrowserServiceCompat
                                                           work (needed for Android Auto)
        -->
        <service
            android:name=".service.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
            BootReceiver.
            Restore the last session after reboot.
            BOOT_COMPLETED requires RECEIVE_BOOT_COMPLETED permission (add if not present).
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>

    <!--
        CHECKLIST — compare against your actual manifest:

        [ ] android:name=".DreamerApplication" on <application>
        [ ] POST_NOTIFICATIONS permission declared
        [ ] FOREGROUND_SERVICE permission declared
        [ ] FOREGROUND_SERVICE_MEDIA_PLAYBACK permission declared
        [ ] MusicService has android:exported="true"
        [ ] MusicService has android:foregroundServiceType="mediaPlayback"
        [ ] MusicService <intent-filter> includes androidx.media3.session.MediaLibraryService
        [ ] MusicService <intent-filter> includes android.media.browse.MediaBrowserService
            (the second one is needed for Media3's DefaultMediaNotificationProvider to
             find the session from outside the app process, e.g. notification controls)
    -->